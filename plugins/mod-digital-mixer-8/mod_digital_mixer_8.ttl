@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix modgui:<http://moddevices.com/ns/modgui#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<http://moddevices.com/plugins/modep/digital-mixer-8>
    a lv2:Plugin, lv2:MixerPlugin ;
    doap:name "MODEP 8-Channel Live Mixer" ;
    doap:license <http://opensource.org/licenses/isc> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    rdfs:comment "Pro-grade 8-channel live mixing console with 1176 preamps, 4-band EQ, De-Esser, Compressor, Dugan AMM Auto-Mixer, Feedback Destroyer, and Dynamic FX Ducking." ;

    lv2:port [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_1" ;
        lv2:name "Ch 1 In" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_2" ;
        lv2:name "Ch 2 In" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "in_3" ;
        lv2:name "Ch 3 In" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "in_4" ;
        lv2:name "Ch 4 In" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "in_5" ;
        lv2:name "Ch 5 In" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "in_6" ;
        lv2:name "Ch 6 In" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "in_7" ;
        lv2:name "Ch 7 In" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "in_8" ;
        lv2:name "Ch 8 In" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "aux_ret_1" ;
        lv2:name "Aux Return 1 (L)" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "aux_ret_2" ;
        lv2:name "Aux Return 2 (R)" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "aux_ret_3" ;
        lv2:name "Aux Return 3 (L)" ;
    ] , [
        a lv2:AudioPort, lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "aux_ret_4" ;
        lv2:name "Aux Return 4 (R)" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 12 ;
        lv2:symbol "out_main_l" ;
        lv2:name "Main Out L" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 13 ;
        lv2:symbol "out_main_r" ;
        lv2:name "Main Out R" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 14 ;
        lv2:symbol "aux_send_1" ;
        lv2:name "Aux Send 1 (IEM 1)" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 15 ;
        lv2:symbol "aux_send_2" ;
        lv2:name "Aux Send 2 (IEM 2)" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 16 ;
        lv2:symbol "aux_send_3" ;
        lv2:name "Aux Send 3 (Reverb)" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 17 ;
        lv2:symbol "aux_send_4" ;
        lv2:name "Aux Send 4 (Delay)" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 18 ;
        lv2:symbol "dir_out_1" ;
        lv2:name "Direct Out 1" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 19 ;
        lv2:symbol "dir_out_2" ;
        lv2:name "Direct Out 2" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 20 ;
        lv2:symbol "dir_out_3" ;
        lv2:name "Direct Out 3" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 21 ;
        lv2:symbol "dir_out_4" ;
        lv2:name "Direct Out 4" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 22 ;
        lv2:symbol "dir_out_5" ;
        lv2:name "Direct Out 5" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 23 ;
        lv2:symbol "dir_out_6" ;
        lv2:name "Direct Out 6" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 24 ;
        lv2:symbol "dir_out_7" ;
        lv2:name "Direct Out 7" ;
    ] , [
        a lv2:AudioPort, lv2:OutputPort ;
        lv2:index 25 ;
        lv2:symbol "dir_out_8" ;
        lv2:name "Direct Out 8" ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 26 ;
        lv2:symbol "master_fader" ;
        lv2:name "Master Fader" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 27 ;
        lv2:symbol "automix_enable" ;
        lv2:name "Auto-Mixer AMM" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort, lv2:InputPort ;
        lv2:index 28 ;
        lv2:symbol "fx_duck_amount" ;
        lv2:name "Dynamic FX Ducking (dB)" ;
        lv2:default 6.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 18.0 ;
    ] .
