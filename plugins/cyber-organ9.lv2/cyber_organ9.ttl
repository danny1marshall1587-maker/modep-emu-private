@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix mod:   <http://moddevices.com/ns#> .

<http://cyber-audio.co.uk/plugins/cyber-organ9>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    doap:name "Cyber Organ 9" ;
    doap:license <http://usefulinc.com/doap/licenses/proprietary> ;
    mod:brand "CyberAudio" ;
    mod:label "Organ 9" ;
    rdfs:comment "Guitar-driven Hammond B3 tonewheel organ pad with smart input noise gate, authentic Leslie 122 rotary speaker, Note Selector chord harmony, and player swell/sustain/release expression." ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Guitar In L/Mono" ;
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Guitar In R" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Organ Out L" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Organ Out R" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ; lv2:symbol "bypass" ; lv2:name "Bypass" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
        lv2:designation lv2:enabled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ; lv2:symbol "third_mode" ; lv2:name "3rd Quality" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 2.0 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [ rdfs:label "Auto (detect from guitar)" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Force Minor 3rd" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Force Major 3rd" ; rdf:value 2 ] ;

    # ── NOTE SELECTOR ─────────────────────────────────────────────────────

    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ; lv2:symbol "ns_sub_oct" ; lv2:name "Sub Octave" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: root -1 octave (-12 semitones)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ; lv2:symbol "ns_sub_fifth" ; lv2:name "Sub Fifth" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: root down a fifth (-7 semitones)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ; lv2:symbol "ns_sub_third" ; lv2:name "Sub Third" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: root down a 3rd (auto major/minor)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ; lv2:symbol "ns_root" ; lv2:name "Root" ;
        lv2:default 8.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: root note (0 semitones)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ; lv2:symbol "ns_third" ; lv2:name "+3rd" ;
        lv2:default 7.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: 3rd above root (auto major/minor)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ; lv2:symbol "ns_fifth" ; lv2:name "+5th" ;
        lv2:default 6.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: perfect 5th above root" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ; lv2:symbol "ns_oct" ; lv2:name "+Oct" ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: one octave above root" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ; lv2:symbol "ns_oct_third" ; lv2:name "+Oct+3rd" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: octave + 3rd above root" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ; lv2:symbol "ns_oct_fifth" ; lv2:name "+Oct+5th" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: octave + 5th above root" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 15 ; lv2:symbol "ns_dbl_oct" ; lv2:name "+2 Oct" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Note level: double octave above root" ;

    # ── HAMMOND DRAWBARS ─────────────────────────────────────────────────

    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 16 ; lv2:symbol "db_16" ; lv2:name "16'" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 8.0 ;
        rdfs:comment "Sub-octave tonewheel drawbar (Brown, 0.5x fundamental)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 17 ; lv2:symbol "db_5_3" ; lv2:name "5 1/3'" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 8.0 ;
        rdfs:comment "Quint tonewheel drawbar (Brown, 1.5x fundamental)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 18 ; lv2:symbol "db_8" ; lv2:name "8'" ;
        lv2:default 8.0 ; lv2:minimum 0.0 ; lv2:maximum 8.0 ;
        rdfs:comment "Fundamental tonewheel drawbar (White, 1x = root pitch)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 19 ; lv2:symbol "db_4" ; lv2:name "4'" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 8.0 ;
        rdfs:comment "Octave tonewheel drawbar (White, 2x)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 20 ; lv2:symbol "db_2_3" ; lv2:name "2 2/3'" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 8.0 ;
        rdfs:comment "Nazard tonewheel drawbar (Black, 3x)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 21 ; lv2:symbol "db_2" ; lv2:name "2'" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 8.0 ;
        rdfs:comment "Super-octave tonewheel drawbar (White, 4x)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 22 ; lv2:symbol "db_1_5" ; lv2:name "1 3/5'" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 8.0 ;
        rdfs:comment "Tierce tonewheel drawbar (Black, 5x)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 23 ; lv2:symbol "db_1_3" ; lv2:name "1 1/3'" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 8.0 ;
        rdfs:comment "Larigot tonewheel drawbar (Black, 6x)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 24 ; lv2:symbol "db_1" ; lv2:name "1'" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 8.0 ;
        rdfs:comment "Sifflöte tonewheel drawbar (White, 8x)" ;

    # ── PERFORMANCE & EXPRESSION ──────────────────────────────────────────

    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 25 ; lv2:symbol "rotary" ; lv2:name "Rotary Speed" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 2.0 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [ rdfs:label "Off" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Slow Chorale" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Fast Tremolo" ; rdf:value 2 ] ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 26 ; lv2:symbol "click" ; lv2:name "Key Click" ;
        lv2:default 3.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Hammond tonewheel 9-contact mechanical key click" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 27 ; lv2:symbol "swell" ; lv2:name "Swell Attack" ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Expression swell pedal attack time" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 28 ; lv2:symbol "sustain" ; lv2:name "Sustain" ;
        lv2:default 4.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Holds organ chord notes when guitar begins decaying" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 29 ; lv2:symbol "release" ; lv2:name "Release Slope" ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Natural smooth release slope for second-player feel" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 30 ; lv2:symbol "gate_sens" ; lv2:name "Gate Sens" ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Smart zero-noise gate sensitivity for chord detection" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 31 ; lv2:symbol "dry" ; lv2:name "Dry Level" ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 32 ; lv2:symbol "wet" ; lv2:name "Wet Level" ;
        lv2:default 8.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 33 ; lv2:symbol "output" ; lv2:name "Output Level" ;
        lv2:default 7.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
    ] ,

    # ── KEY & SCALE DIATONIC LOCK ────────────────────────────────────────

    [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 34 ; lv2:symbol "key_root" ; lv2:name "Diatonic Key Lock" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 12 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [ rdfs:label "Auto (Full Chromatic)" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "C" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "C#" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "D" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "D#" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "E" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "F" ; rdf:value 6 ] ;
        lv2:scalePoint [ rdfs:label "F#" ; rdf:value 7 ] ;
        lv2:scalePoint [ rdfs:label "G" ; rdf:value 8 ] ;
        lv2:scalePoint [ rdfs:label "G#" ; rdf:value 9 ] ;
        lv2:scalePoint [ rdfs:label "A" ; rdf:value 10 ] ;
        lv2:scalePoint [ rdfs:label "A#" ; rdf:value 11 ] ;
        lv2:scalePoint [ rdfs:label "B" ; rdf:value 12 ] ;
        rdfs:comment "Locks chord detection to key signature (0=Auto chromatic)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 35 ; lv2:symbol "scale_mode" ; lv2:name "Scale Mode" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [ rdfs:label "Auto" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Major / Ionian" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "Minor / Aeolian" ; rdf:value 2 ] ;
        rdfs:comment "Diatonic scale mode for key lock" ;
    ] ,

    # ── DUAL PITCH DETECTOR CALIBRATION (DEV MODE WITH ULTRA-WIDE SCOPE) ──

    [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 36 ; lv2:symbol "track_sens" ; lv2:name "Detector Sensitivity" ;
        lv2:default 8.0 ; lv2:minimum 0.1 ; lv2:maximum 20.0 ;
        rdfs:comment "Detector sensitivity threshold (higher = hears delicate soft picking & harmonics)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 37 ; lv2:symbol "track_stab" ; lv2:name "Chord Stability / Hysteresis" ;
        lv2:default 6.0 ; lv2:minimum 0.1 ; lv2:maximum 20.0 ;
        rdfs:comment "Chroma smoothing & hysteresis (higher = rock-solid pad lock, lower = immediate jump)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 38 ; lv2:symbol "debounce_speed" ; lv2:name "Debounce / Confirmation" ;
        lv2:default 2.0 ; lv2:minimum 1.0 ; lv2:maximum 16.0 ;
        lv2:portProperty lv2:integer ;
        rdfs:comment "Consecutive matching evaluation cycles required (1 = instant ~5ms, 2-4 = optimal, 10+ = heavy hold)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 39 ; lv2:symbol "filter_q" ; lv2:name "Resonator Bandpass Q" ;
        lv2:default 7.0 ; lv2:minimum 1.5 ; lv2:maximum 30.0 ;
        rdfs:comment "Q factor of 36 resonator bank (lower = instant wide pitch grab, higher = sharp note isolation)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 40 ; lv2:symbol "bass_boost" ; lv2:name "Bass Weighting" ;
        lv2:default 6.0 ; lv2:minimum 0.0 ; lv2:maximum 20.0 ;
        rdfs:comment "Low string fundamental weight multiplier" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 41 ; lv2:symbol "agc_speed" ; lv2:name "Auto Gain Speed" ;
        lv2:default 6.0 ; lv2:minimum 0.0 ; lv2:maximum 20.0 ;
        rdfs:comment "Input AGC tracking speed (0 = off, 6 = natural dynamic, 20 = hyper leveler)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 42 ; lv2:symbol "ac_weight" ; lv2:name "Autocorrelation 2nd-Detector Mix" ;
        lv2:default 8.0 ; lv2:minimum 0.0 ; lv2:maximum 20.0 ;
        rdfs:comment "Weight of Time-Domain Autocorrelation Root Extractor (0 = bank only, 8 = balanced fusion, 20 = forced root lock)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 43 ; lv2:symbol "ac_clip" ; lv2:name "Time-Domain Center Clip" ;
        lv2:default 4.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Center clipping depth on time-domain waveform to eliminate upper harmonic octave confusion" ;

    # ── AUTO LOWEST-NOTE RHYTHM BASS PLAYER ──────────────────────────────

    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 44 ; lv2:symbol "bass_level" ; lv2:name "Bass Level" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Auto lowest-note bass accompaniment volume (0 = off)" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 45 ; lv2:symbol "bass_pattern" ; lv2:name "Bass Pattern" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 6.0 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [ rdfs:label "0: Off" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "1: Drone Sustain" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "2: 8th Note Rock Pulse" ; rdf:value 2 ] ;
        lv2:scalePoint [ rdfs:label "3: Root-Octave Groove" ; rdf:value 3 ] ;
        lv2:scalePoint [ rdfs:label "4: Root-5th Country/Blues" ; rdf:value 4 ] ;
        lv2:scalePoint [ rdfs:label "5: Walking Bass" ; rdf:value 5 ] ;
        lv2:scalePoint [ rdfs:label "6: Dub / Reggae Drop" ; rdf:value 6 ] ;
        rdfs:comment "Rhythm step sequencer pattern" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 46 ; lv2:symbol "bass_bpm" ; lv2:name "Bass Tempo (BPM)" ;
        lv2:default 120.0 ; lv2:minimum 40.0 ; lv2:maximum 240.0 ;
        rdfs:comment "Sequencer tempo in beats per minute" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 47 ; lv2:symbol "bass_tap" ; lv2:name "Bass Tap Tempo" ;
        lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
        rdfs:comment "Tap tempo trigger for rhythm bass sequencer" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 48 ; lv2:symbol "bass_tone" ; lv2:name "Bass Tone / Lowpass" ;
        lv2:default 5.0 ; lv2:minimum 0.0 ; lv2:maximum 10.0 ;
        rdfs:comment "Bass tone filter (0 = deep sub sine, 10 = punchy growl)" ;
    ] .

