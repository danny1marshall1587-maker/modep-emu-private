@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-evans-drummer-pro>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-evans-drummer-pro.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "CyberAudio" ;
        modgui:label "Evans Drummer Pro" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "style" ;
            lv2:name "Style" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "bpm_override" ;
            lv2:name "BPM" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "accent_sens" ;
            lv2:name "Accent" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "ghost_density" ;
            lv2:name "Ghost" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "fill_density" ;
            lv2:name "Fills" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "groove" ;
            lv2:name "Groove" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "overall_velocity" ;
            lv2:name "Dynamics" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "open_hh_thresh" ;
            lv2:name "Splash" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "crash_on_chorus" ;
            lv2:name "Crash" ;
        ] , [
            lv2:index 9 ;
            lv2:symbol "record_song" ;
            lv2:name "Learn" ;
        ] , [
            lv2:index 10 ;
            lv2:symbol "mute" ;
            lv2:name "Mute" ;
        ] , [
            lv2:index 11 ;
            lv2:symbol "adventurous" ;
            lv2:name "Jam / Free" ;
        ] , [
            lv2:index 12 ;
            lv2:symbol "strum_only_mode" ;
            lv2:name "Strum Only" ;
        ] , [
            lv2:index 13 ;
            lv2:symbol "kit_master_vol" ;
            lv2:name "Kit Vol" ;
        ] , [
            lv2:index 14 ;
            lv2:symbol "stop_crash" ;
            lv2:name "Stop Here" ;
        ] , [
            lv2:index 15 ;
            lv2:symbol "fill_now" ;
            lv2:name "Fill Here" ;
        ] , [
            lv2:index 16 ;
            lv2:symbol "reset_listen" ;
            lv2:name "New Song" ;
        ] ;
    ] .
