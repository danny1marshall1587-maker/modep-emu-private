@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-ultimate-hybrid>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-ultimate-hybrid.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:javascript <modgui/script.js> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Ultimate Hybrid" ;
        modgui:model "boxy" ;
        modgui:panel "1-select-1-knob" ;
        modgui:color "gold" ;
        modgui:knob "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "clean_vol" ;
            lv2:name "Clean Vol" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "drive_gain" ;
            lv2:name "JMP Gain" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "drive_vol" ;
            lv2:name "JMP Vol" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "bass" ;
            lv2:name "Bass" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "mid" ;
            lv2:name "Middle" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "treble" ;
            lv2:name "Treble" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "rev_mix" ;
            lv2:name "Spring Mix" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "rev_drip" ;
            lv2:name "Drip" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "trem_speed" ;
            lv2:name "Vib Speed" ;
        ] , [
            lv2:index 9 ;
            lv2:symbol "trem_depth" ;
            lv2:name "Vib Depth" ;
        ] , [
            lv2:index 10 ;
            lv2:symbol "master" ;
            lv2:name "Master" ;
        ]
    ] .
